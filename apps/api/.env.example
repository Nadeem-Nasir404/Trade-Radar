# Copy this file to .env in apps/api and fill in real values for anything you have.
# Nothing here is required to run CoinRadar in demo mode except DATABASE_URL, REDIS_URL and the two JWT secrets.

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/levelpulse
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/levelpulse

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate strong random values, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (optional - login screen hides the button if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Magic link signing secret (optional in development, where a built-in default is used; required in production)
MAGIC_LINK_SECRET=change-me-to-a-third-long-random-string

# --- Market data ---------------------------------------------------------------
# DEMO_MODE=true runs the whole app on MockMarketDataProvider with zero external API keys.
# Set to false + supply nothing else and Binance's public WebSocket streams are used directly
# (no API key required for public market data).
DEMO_MODE=true
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
# Powers real spot quotes (e.g. XAU/USD gold) for instruments with no crypto-exchange feed.
# Free key: https://twelvedata.com/pricing - without one those instruments fall back to demo walk.
TWELVE_DATA_API_KEY=
TWELVE_DATA_POLL_INTERVAL_MS=60000


# --- Notifications ---------------------------------------------------------------
# Leave SMTP_* unset in dev to use an auto-created Ethereal test inbox (logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoinRadar <alerts@levelpulse.app>"

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@levelpulse.app

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=

# --- Billing (stubbed - no real Stripe integration yet) ---------------------------------
# Must be false in production - the API refuses to start otherwise.
ENABLE_MOCK_BILLING=true

# --- Rate limiting ---------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Set when the API runs behind a reverse proxy (e.g. 1 for a single proxy hop) so rate limits use the real client IP.
TRUST_PROXY=
