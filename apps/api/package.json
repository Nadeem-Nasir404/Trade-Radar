{
  "name": "@levelpulse/api",
  "version": "0.1.0",
  "private": true,
  "description": "LevelPulse NestJS backend - alert engine, market-data ingestion, notifications, admin API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@levelpulse/shared-types": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/throttler": "6.6.0",
    "@nestjs/websockets": "12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.6",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nanoid": "^3.3.7",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.3",
    "@types/nodemailer": "8.0.2",
    "@types/node": "24.13.5",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "30.0.0",
    "@types/ioredis-mock": "8.2.8",
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "ioredis-mock": "8.13.1",
    "jest": "30.5.1",
    "prettier": "3.9.7",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@levelpulse/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts"
    }
  }
}
