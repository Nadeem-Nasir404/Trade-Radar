# Copy to .env. EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle automatically.
#
# IMPORTANT: "localhost" means a different thing depending on where you're running the app:
#   - iOS Simulator:      http://localhost:4000/api/v1                  (works as-is)
#   - Android Emulator:   http://10.0.2.2:4000/api/v1                   (emulator's alias for host machine)
#   - Physical device:    http://<your-machine-LAN-IP>:4000/api/v1      (e.g. http://192.168.1.20:4000/api/v1)
#     and the backend's CORS_ORIGIN / Socket.IO cors must allow that origin too.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000
